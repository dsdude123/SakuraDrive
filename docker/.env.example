# Copy to .env next to docker-compose.yml and adjust.

# Port the web interface listens on. 8099 continues the 8096/8097/8098 block;
# confirm with `sudo ss -ltnp` before assuming it is free.
SAKURADRIVE_PORT=8099

# Timezone for container log timestamps. The schedule uses the timezone you pick
# in Settings, so this only affects `docker logs`.
TZ=America/Los_Angeles

# trace | debug | info | warn | error
SAKURADRIVE_LOG_LEVEL=info

# Skip the sign-in screen entirely. Only for a trusted LAN — anyone who can reach
# the port gets full control, including the ability to read your Kopia credentials.
SAKURADRIVE_DISABLE_AUTH=false

# Which published image to run. Leave unset to follow `latest`, or pin to a commit
# to roll back: the CI job tags every push to the default branch as sha-<short sha>,
# and the tags are listed at https://github.com/dsdude123/SakuraDrive/pkgs/container/sakuradrive
#
# Rolling the server back rolls every agent back with it, on their next run.
# SAKURADRIVE_TAG=sha-abc1234
